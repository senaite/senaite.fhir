<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Patient To FHIR -->
  <adapter for="senaite.patient.interfaces.IPatient"
           factory=".patient.PatientToResource"/>

  <!-- ResultsReport To FHIR -->
  <adapter for="senaite.core.interfaces.IResultsReport"
           factory=".diagnosticreport.ResultsReportToResource"
           provides="senaite.fhir.interfaces.IContentToFHIR"/>

  <!-- Analysis To FHIR Observation -->
  <adapter for="bika.lims.interfaces.IAnalysis"
           factory=".observation.AnalysisToObservation"
           provides="senaite.fhir.interfaces.IContentToFHIR"/>

  <!-- AnalysisRequest to FHIR Specimen (native SENAITE samples without annotation) -->
  <adapter name="Specimen"
           factory=".analysisrequest.AnalysisRequestToSpecimen"
           for="bika.lims.interfaces.IAnalysisRequest"
           provides="senaite.fhir.interfaces.IContentToFHIR"/>

  <!-- AnalysisRequest revoke transition to FHIR -->
  <adapter name="senaite.fhir.action.revoke"
           factory=".analysisrequest.AnalysisRequestRevokedToResource"
           for="bika.lims.interfaces.IAnalysisRequest"
           provides="senaite.fhir.interfaces.IContentActionToFHIR"/>

  <!-- Analysis to FHIR ServiceRequest (device-scoped, intent=filler-order,
       generated only when the Analysis has an Instrument assigned) -->
  <adapter name="ServiceRequest"
           factory=".analysis.AnalysisToInstrumentServiceRequest"
           for="bika.lims.interfaces.IAnalysis"
           provides="senaite.fhir.interfaces.IContentToFHIR"/>

  <!-- FHIR To Patient -->
  <adapter for="senaite.fhir.interfaces.IPatientResource"
           factory=".patient.ResourceToPatient"/>

  <!-- FHIR To Client
  # TODO FHIR Client Resource does not exist, but Organization, but we need
         this conversion to get the proper converter. Maybe use named adapter?
  -->
  <adapter for="senaite.fhir.interfaces.IOrganizationResource"
           factory=".client.ResourceToClient"/>

  <!-- FHIR To Contact
  # TODO FHIR Contact Resource does not exist, but Practitioner, but we need
         this conversion to get the proper converter. Maybe use named adapter?
  -->
  <adapter for="senaite.fhir.interfaces.IPractitionerResource"
           factory=".contact.ResourceToContact"/>

  <!-- Contact To FHIR Practitioner -->
  <adapter for="senaite.core.interfaces.IContact"
           factory=".contact.ContactToPractitioner"/>

  <!-- FHIR To AnalysisRequest -->
  <adapter for="senaite.fhir.interfaces.IServiceRequestResource"
           factory=".analysisrequest.ResourceToAnalysisRequest"/>

  <!-- FHIR Observation To Analysis result -->
  <adapter for="senaite.fhir.interfaces.IObservationResource"
           factory=".observation.ResourceToAnalysisResult"/>

  <!-- Instrument To FHIR Device -->
  <adapter for="bika.lims.interfaces.IInstrument"
           factory=".device.InstrumentToDevice"
           provides="senaite.fhir.interfaces.IContentToFHIR"/>

</configure>
