<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="senaite.fhir">

  <genericsetup:upgradeStep
      title="Index Client Order Number for FHIR sample groups"
      description="Add and populate the Sample catalog index used to validate ServiceRequest requisitions"
      source="1001"
      destination="1002"
      handler=".v01_00_000.add_sample_group_index"
      profile="senaite.fhir:default"/>

  <genericsetup:upgradeStep
      title="Setup behavior for Contact"
      description="Setup behavior for Contact"
      source="1000"
      destination="1001"
      handler=".v01_00_000.setup_contact_behavior"
      profile="senaite.fhir:default"/>

</configure>
